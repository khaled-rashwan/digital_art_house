{
  "cli": {
    "version": ">= 14.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "AMPLIFY_ENV": "dev"
      },
      "secrets": {
         "AMPLIFY_OUTPUTS_DEV": "@AMPLIFY_OUTPUTS_DEV"
      },
      "hooks": {
        "preInstall": [
          {
            "file": "./eas-hooks/eas-build-inject-amplify-config.sh",
            "cache": "false"
          }
        ]
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "AMPLIFY_ENV": "dev"
      },
      "secrets": {
         "AMPLIFY_OUTPUTS_DEV": "@AMPLIFY_OUTPUTS_DEV"
      },
      "hooks": {
        "preInstall": [
          {
            "file": "./eas-hooks/eas-build-inject-amplify-config.sh",
            "cache": "false"
          }
        ]
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AMPLIFY_ENV": "main"
      },
      "secrets": {
         "AMPLIFY_OUTPUTS_MAIN": "@AMPLIFY_OUTPUTS_MAIN"
      },
      "hooks": {
        "preInstall": [
          {
            "file": "./eas-hooks/eas-build-inject-amplify-config.sh",
            "cache": "false"
          }
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
